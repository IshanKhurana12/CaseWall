VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_key
FROM_EMAIL=orders@example.com
SITE_ORIGIN=https://yourdomain.com

SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in
SHIPROCKET_EMAIL=your_shiprocket_email@example.com
SHIPROCKET_PASSWORD=your_shiprocket_password
# Or use the API key/secret pair instead of email/password:
# SHIPROCKET_API_KEY=your_api_key
# SHIPROCKET_API_SECRET=your_api_secret
SHIPROCKET_PICKUP_LOCATION=default
SHIPROCKET_CHANNEL_ID=1
SHIPROCKET_COUNTRY=India
SHIPROCKET_PACKET_LENGTH=10
SHIPROCKET_PACKET_BREADTH=10
SHIPROCKET_PACKET_HEIGHT=5
SHIPROCKET_PACKET_WEIGHT=0.5

SHIPPING_RATE_RUPEES=80
SHIPPING_FREE_THRESHOLD_RUPEES=500
COD_ADVANCE_RUPEES=100

VITE_SHIPPING_RATE_RUPEES=80
VITE_SHIPPING_FREE_THRESHOLD_RUPEES=500
VITE_CLEANUP_TRIGGER_INTERVAL_MINUTES=15
